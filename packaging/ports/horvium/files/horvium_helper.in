#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
# shellcheck disable=SC2034,SC1091
# PROVIDE: horvium_helper
# REQUIRE: LOGIN
# KEYWORD: shutdown
. /etc/rc.subr
name=horvium_helper
rcvar=horvium_helper_enable
hv_mode=helper
load_rc_config "$name"
: "${horvium_helper_enable:=NO}"
. %%PREFIX%%/libexec/horvium/rc.subr
horvium_command_allowed "${1:-}" || exit 1
run_rc_command "$1"
