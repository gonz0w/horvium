#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
# Require explicit service stop before removing payload. Preserve all state.
for entry in /var/run/horvium/helper.pid /var/run/horvium/management.pid /var/run/horvium/inventory.sock; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
        echo 'horvium: removal refused while profile state is active or uncertain' >&2
        exit 1
    fi
done
exit 0
