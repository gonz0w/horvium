#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
set -eu
msgfile="$1"
first=$(sed -n '1p' "$msgfile")
case "$first" in
  Merge\ *) ;;
  *)
    printf '%s\n' "$first" | grep -Eq '^(feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{3,100}$' || {
      echo "Commit subject must match: <type>(<scope>): <summary>" >&2
      exit 1
    }
    ;;
esac
identity=$(git var GIT_AUTHOR_IDENT | sed 's/>.*/>/')
git interpret-trailers --parse < "$msgfile" | grep -Fxi "Signed-off-by: $identity" >/dev/null || {
  echo "Author DCO sign-off required; use git commit -s" >&2
  exit 1
}
